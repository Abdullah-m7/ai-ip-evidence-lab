{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ipel/stage008-external-response.schema.json",
  "title": "Stage 008 external adjudication response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "response_version",
    "bundle_id",
    "distribution_id",
    "bundle_sha256",
    "data_origin",
    "adjudicator_id",
    "responses"
  ],
  "properties": {
    "response_version": {"const": "stage008-external-response-v1"},
    "bundle_id": {"type": "string", "pattern": "^BND-[A-F0-9]{16}$"},
    "distribution_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{3,80}$"},
    "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "data_origin": {"enum": ["REAL_HUMAN", "SYNTHETIC_NON_HUMAN"]},
    "synthetic_fixture": {"type": "boolean"},
    "adjudicator_id": {"type": "string", "minLength": 1, "maxLength": 80},
    "responses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "external_case_id",
          "decision",
          "missing_information_codes",
          "confidence_0_to_100",
          "prior_exposure",
          "conflict_of_interest"
        ],
        "properties": {
          "external_case_id": {"type": "string", "pattern": "^CASE-[A-F0-9]{16}$"},
          "decision": {"enum": ["READY", "NOT_READY", "UNSURE"]},
          "missing_information_codes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "WORK_TYPE", "WORK_SOURCE", "USE_PURPOSE", "USE_DATE", "PUBLICATION",
                "ACQUISITION", "NECESSITY", "PROHIBITED_USE_STATUS", "COMMERCIAL_EFFECT",
                "AUTHOR_INTERESTS", "OUTPUT_CONTEXT", "INDEPENDENT_ELEMENTS", "USE_EVENT_EVIDENCE"
              ]
            }
          },
          "confidence_0_to_100": {"type": "number", "minimum": 0, "maximum": 100},
          "rationale": {"type": ["string", "null"], "maxLength": 4000},
          "prior_exposure": {"type": "boolean"},
          "conflict_of_interest": {"type": "boolean"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"data_origin": {"const": "SYNTHETIC_NON_HUMAN"}}},
      "then": {"required": ["synthetic_fixture"], "properties": {"synthetic_fixture": {"const": true}}}
    },
    {
      "if": {"properties": {"data_origin": {"const": "REAL_HUMAN"}}},
      "then": {"properties": {"synthetic_fixture": {"not": {"const": true}}}}
    }
  ]
}
